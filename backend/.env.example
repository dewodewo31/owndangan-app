APP_ENV=development
PORT=8080

DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=owndangan
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_LOG_SQL=false

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

MIDTRANS_SERVER_KEY=Midtrans-server-key-here
MIDTRANS_CLIENT_KEY=Midtrans-client-key-here
MIDTRANS_IS_PRODUCTION=false

STORAGE_PROVIDER=local
STORAGE_BUCKET=uploads
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_URL=http://localhost:8080/uploads

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
