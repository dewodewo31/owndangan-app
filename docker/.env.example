# ============================================================
# ngrok DEVELOPMENT tunnel configuration (DEVELOPMENT ONLY)
# ============================================================
# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — never commit real secrets.

# Your ngrok authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
# Required for the ngrok-backend / ngrok-frontend containers to establish tunnels.
NGROK_AUTHTOKEN=

# Public URLs are assigned by ngrok at runtime. On the FREE tier the domain
# changes on every container restart. Fill these in AFTER starting the stack,
# using:
#   docker compose -f docker/docker-compose.yml exec ngrok-backend \
#     curl -s http://localhost:4040/api/tunnels
#   docker compose -f docker/docker-compose.yml exec ngrok-frontend \
#     curl -s http://localhost:4040/api/tunnels
NGROK_BACKEND_URL=
NGROK_FRONTEND_URL=

# Frontend public URL (used for email links / references in the backend).
# Set this to the frontend ngrok URL once known. Defaults to localhost for
# purely local development.
FRONTEND_URL=http://localhost:3000
